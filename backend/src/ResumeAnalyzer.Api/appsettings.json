{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Ai": {
    "Provider": "Gemini"
  },
  "Gemini": {
    "Model": "gemini-3.8-flash",
    "MaxOutputTokens": 8192,
    "TimeoutSeconds": 90,
    "ThinkingLevel": "low"
  },
  "Anthropic": {
    "Model": "claude-haiku-4-5-20251001",
    "MaxTokens": 2000,
    "TimeoutSeconds": 90
  },
  "RateLimiting": {
    "Analyses": {
      "PermitLimit": 10,
      "WindowMinutes": 60
    }
  }
}

{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=resume_analyzer;Username=postgres;Password=<your-password>"
  },
  "Ai": {
    "Provider": "Gemini"
  },
  "Gemini": {
    "ApiKey": "<your-gemini-api-key, or use dotnet user-secrets>"
  },
  "Anthropic": {
    "ApiKey": "<your-anthropic-api-key, only needed when Ai:Provider is Claude>",
    "Model": "<claude-model-id>"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200" ]
  }
}
